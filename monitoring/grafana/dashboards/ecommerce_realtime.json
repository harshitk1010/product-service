{
  "title": "E-Commerce Real-Time Analytics",
  "uid": "ecommerce-realtime",
  "version": 1,
  "schemaVersion": 36,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Events per Second (by Topic)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (topic) (rate(kafka_events_produced_total[1m]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 2,
      "title": "Revenue (Last 1 Hour)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(increase(ecommerce_order_revenue_total[1h]))",
          "legendFormat": "Revenue"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 5000},
              {"color": "green", "value": 20000}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Orders per Minute",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(ecommerce_orders_total[1m])) * 60",
          "legendFormat": "Orders/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        }
      }
    },
    {
      "id": 4,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumer_group_lag{consumer_group='spark-streaming-consumer'})",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 10000},
              {"color": "red", "value": 50000}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Conversion Funnel (Last 15 min)",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "ecommerce_funnel_sessions_product_viewed",
          "legendFormat": "Product Viewed"
        },
        {
          "expr": "ecommerce_funnel_sessions_add_to_cart",
          "legendFormat": "Added to Cart"
        },
        {
          "expr": "ecommerce_funnel_sessions_checkout",
          "legendFormat": "Checkout Started"
        },
        {
          "expr": "ecommerce_funnel_sessions_purchased",
          "legendFormat": "Purchased"
        }
      ],
      "options": {"orientation": "horizontal"}
    },
    {
      "id": 6,
      "title": "Spark Streaming Batch Duration",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "spark_streaming_lastBatchProcessingDelay_ms / 1000",
          "legendFormat": "Batch Duration (s)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 15},
              {"color": "red", "value": 30}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Dead Letter Queue Rate",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 16},
      "targets": [
        {
          "expr": "sum by (reason) (rate(kafka_events_failed_total[5m]))",
          "legendFormat": "DLQ - {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {"fixedColor": "red", "mode": "fixed"}
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "options": ["production", "staging"],
        "current": {"value": "production"}
      }
    ]
  }
}
