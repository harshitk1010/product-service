# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
SCHEMA_REGISTRY_URL=http://localhost:8081

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=ecommerce-analytics-lake

# ── PostgreSQL ────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ecommerce_analytics
PG_USER=postgres
PG_PASSWORD=postgres
PG_JDBC_URL=jdbc:postgresql://localhost:5432/ecommerce_metrics

# ── Snowflake ─────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your-account.us-east-1
SNOWFLAKE_USER=dbt_user
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=ANALYTICS_TRANSFORM_ROLE
SNOWFLAKE_WAREHOUSE=ANALYTICS_TRANSFORM_WH
SNOWFLAKE_DATABASE=ANALYTICS_DB
SNOWFLAKE_SCHEMA=STAGING

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_FERNET_KEY=generate-with-python-cryptography
AIRFLOW_SECRET_KEY=generate-random-string

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin

# ── Power BI ──────────────────────────────────────────────────────────────────
POWERBI_DATASET_ID=
POWERBI_WORKSPACE_ID=
